# Copiază acest fișier ca .env.local și completează valorile.
# .env.local nu se pune în git.

# Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Doar pentru testele de integrare (npm run test:integration).
# Cheia de serviciu ocolește RLS; nu o folosi în altă parte.
SUPABASE_SERVICE_ROLE_KEY=
TEST_USER_PASSWORD=
